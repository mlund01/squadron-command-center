# Enable this only for the new control-plane deployment profile.
COMMAND_CENTER_MODE=control-plane
COMMAND_CENTER_PUBLIC_URL=https://command.example.com
COMMAND_CENTER_DATABASE_URL=postgres://command_center:change-me@postgres:5432/command_center?sslmode=disable
# Generate with: openssl rand -hex 32
COMMAND_CENTER_MASTER_KEY=
# Optional. When set, the first browser setup must provide this token.
COMMAND_CENTER_SETUP_TOKEN=

# Optional external identity provider. When omitted, first-run browser setup
# creates the local administrator and manages its password in PostgreSQL.
OAUTH_ISSUER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://command.example.com/auth/callback
# Generate with: openssl rand -hex 32
OAUTH_COOKIE_SECRET=
